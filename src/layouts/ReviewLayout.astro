---
import { getCollection } from 'astro:content';
import type { ProductCategory } from '~/content.config';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import FieldNoteTag from '~/components/FieldNoteTag.astro';
import AuthorChip from '~/components/AuthorChip.astro';
import KeepReading from '~/components/KeepReading.astro';
import ReadingProgress from '~/components/ReadingProgress.astro';
import TableOfContents from '~/components/TableOfContents.astro';
import RelatedRail from '~/components/RelatedRail.astro';

export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  heroAlt?: string;
  productName: string;
  rating?: number;
  usageDuration: string;
  productCategory: ProductCategory;
  pros: string[];
  cons: string[];
  hasAffiliateLinks?: boolean;
  affiliateDisclaimer?: string;
  slug: string;
  tags?: string[];
  relatedSlugs?: string[];
  readingMinutes?: number;
  verdict?: string;
  headings?: Heading[];
  issueNumber?: number;
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  heroImage,
  heroAlt,
  productName,
  rating,
  usageDuration,
  productCategory,
  pros,
  cons,
  hasAffiliateLinks = true,
  affiliateDisclaimer,
  slug,
  tags = [],
  readingMinutes,
  verdict,
  headings = [],
  issueNumber,
} = Astro.props;

const siteUrl = 'https://thebreakingdad.co.uk';
const canonicalUrl = `${siteUrl}/reviews/${slug}/`;

const categoryLabels: Record<ProductCategory, string> = {
  'family-tech': 'Family tech',
  'parenting-kit': 'Parenting kit',
  'shoes-and-fitness': 'Shoes and fitness',
  'home-and-lifestyle': 'Home and lifestyle',
  'days-out': 'Days out',
};

const breadcrumbTrail = [
  { label: 'Home', href: '/' },
  { label: 'Reviews', href: '/reviews/' },
  { label: title, href: canonicalUrl },
];

// Roundups (no single rating) emit Article schema instead of Review — Google
// rejects Review markup without reviewRating.
const reviewSchema = rating
  ? {
      '@context': 'https://schema.org',
      '@type': 'Review',
      name: title,
      description,
      url: canonicalUrl,
      datePublished: publishDate.toISOString(),
      dateModified: (updatedDate ?? publishDate).toISOString(),
      author: { '@type': 'Person', name: 'Dan Betts', url: `${siteUrl}/about/` },
      reviewRating: { '@type': 'Rating', ratingValue: rating, bestRating: 5, worstRating: 1 },
      itemReviewed: { '@type': 'Product', name: productName },
      publisher: { '@type': 'Organization', name: 'The Breaking Dad', url: siteUrl },
      ...(heroImage ? { image: heroImage.startsWith('http') ? heroImage : `${siteUrl}${heroImage}` } : {}),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      url: canonicalUrl,
      datePublished: publishDate.toISOString(),
      dateModified: (updatedDate ?? publishDate).toISOString(),
      author: { '@type': 'Person', name: 'Dan Betts', url: `${siteUrl}/about/` },
      publisher: { '@type': 'Organization', name: 'The Breaking Dad', url: siteUrl },
      ...(heroImage ? { image: heroImage.startsWith('http') ? heroImage : `${siteUrl}${heroImage}` } : {}),
    };

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbTrail.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: item.href.startsWith('http') ? item.href : `${siteUrl}${item.href}`,
  })),
};

const filledStars = rating ? Math.floor(rating) : 0;
const hasHalfStar = rating ? rating % 1 >= 0.5 : false;
const emptyStars = 5 - filledStars - (hasHalfStar ? 1 : 0);

const defaultDisclaimer = `This review contains affiliate links, marked with *. If you buy through these links, I earn a small commission at no extra cost to you. I only recommend things I've actually used and genuinely rate. <a href="/affiliate-disclosure/">Full disclosure here</a>.`;

const allReviews = await getCollection('reviews', ({ data }) => !data.draft);
const relatedItems = allReviews
  .filter((r) => r.data.productCategory === productCategory && r.id.replace(/\.(md|mdx)$/, '') !== slug)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3)
  .map((r) => ({
    title: r.data.title,
    href: `/reviews/${r.id.replace(/\.(md|mdx)$/, '')}/`,
    image: r.data.heroImage,
    imageAlt: r.data.heroAlt,
    kind: categoryLabels[r.data.productCategory] ?? r.data.productCategory,
  }));
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={heroImage}
  ogType="article"
  publishDate={publishDate}
  updatedDate={updatedDate}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <ReadingProgress />

  <article class="post-layout" id="post-content">
    <div class="post-layout__crumb-row">
      <div class="container">
        <Breadcrumbs trail={breadcrumbTrail} />
      </div>
    </div>

    <header class="post-layout__head">
      <div class="container--narrow">
        <FieldNoteTag label="Review" number={issueNumber} />
        <span class="eyebrow eyebrow-accent post-layout__kicker">
          {categoryLabels[productCategory] ?? productCategory} · Review
        </span>
        <h1 class="display-2 post-layout__title">{title}</h1>
        <p class="lede post-layout__lede">{description}</p>

        {hasAffiliateLinks && (
          <span class="disclosure-pill" title="Some links earn a commission">
            <span class="disclosure-pill__dot" aria-hidden="true"></span>
            Affiliate links · honest recommendations
          </span>
        )}

        <AuthorChip date={publishDate} readingMinutes={readingMinutes} />
      </div>

      {heroImage && (
        <div class="container">
          <figure class="post-layout__hero">
            <img src={heroImage} alt={heroAlt ?? title} width="1200" height="525" loading="eager" />
            {heroAlt && <figcaption class="meta text-c">{heroAlt}</figcaption>}
          </figure>
        </div>
      )}
    </header>

    <div class="post-layout__body">
      <div class="container">
        <div class="post-layout__grid">
          <TableOfContents headings={headings} totalMinutes={readingMinutes} />

          <div class="post-layout__main">
            <aside class="verdict-card" aria-label="Review verdict">
              <span class="verdict-card__kicker">{rating ? 'The Verdict' : 'The Roundup'}</span>
              <div class="verdict-card__rating-row">
                {rating && (
                  <>
                    <span class="verdict-card__stars" aria-label={`Rating: ${rating} out of 5`}>
                      {'★'.repeat(filledStars)}{hasHalfStar ? '½' : ''}{'☆'.repeat(emptyStars)}
                    </span>
                    <span class="verdict-card__score">{rating}/5</span>
                  </>
                )}
                <span class="verdict-card__duration">{usageDuration}</span>
              </div>
              {verdict && <p class="verdict-card__verdict">{verdict}</p>}
              <div class="verdict-card__grid">
                <div class="verdict-card__col verdict-card__col--pros">
                  <div class="verdict-card__col-heading">Pros</div>
                  <ul class="verdict-card__list">
                    {pros.map((pro) => <li>{pro}</li>)}
                  </ul>
                </div>
                <div class="verdict-card__col verdict-card__col--cons">
                  <div class="verdict-card__col-heading">Cons</div>
                  <ul class="verdict-card__list">
                    {cons.map((con) => <li>{con}</li>)}
                  </ul>
                </div>
              </div>
            </aside>

            <div class="prose">
              <slot />
            </div>

            {hasAffiliateLinks && (
              <div class="affiliate-disclosure" role="note">
                <Fragment set:html={affiliateDisclaimer ?? defaultDisclaimer} />
              </div>
            )}

            <div class="post-layout__filed">
              <span class="meta">Filed under: <a href="/reviews/">{categoryLabels[productCategory] ?? productCategory}</a></span>
            </div>
          </div>

          <RelatedRail items={relatedItems} title="More on this" />
        </div>
      </div>
    </div>

    <KeepReading items={relatedItems} title="Keep reading" />
  </article>
</BaseLayout>

<style>
  .post-layout { background: var(--color-paper); }
  .post-layout__crumb-row {
    border-bottom: 1px solid var(--color-rule-soft);
    padding-block: 14px;
  }
  .post-layout__head { padding-block: 44px 0; }
  .post-layout__kicker { display: block; margin-bottom: 16px; }
  .post-layout__title { margin: 0 0 20px; text-wrap: balance; }
  .post-layout__lede { margin-bottom: 18px; }
  .post-layout__hero {
    margin: 36px 0 0;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16/7;
  }
  .post-layout__hero img {
    width: 100%; height: 100%;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
  }
  .post-layout__hero figcaption { margin-top: 12px; text-align: center; }
  .post-layout__body { padding-block: 48px 0; }

  .post-layout__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 1100px) {
    .post-layout__grid {
      grid-template-columns: 200px minmax(0, 1fr) 260px;
      gap: 40px;
      align-items: start;
    }
  }

  .post-layout__main {
    max-width: 680px;
    width: 100%;
    margin-inline: auto;
  }

  .post-layout__main .prose { max-width: 680px; }

  @media (max-width: 1099px) {
    .post-layout__grid > .toc,
    .post-layout__grid > .related-rail {
      display: none;
    }
  }

  .post-layout__filed {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--color-rule);
  }
  .post-layout__filed a { color: var(--color-accent); }
  .post-layout__head .field-note-tag { margin-bottom: 18px; }
  .post-layout__head .disclosure-pill { margin-bottom: 12px; }
</style>
