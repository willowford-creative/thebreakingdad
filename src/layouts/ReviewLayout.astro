---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import AuthorBio from '~/components/AuthorBio.astro';
import RelatedPosts from '~/components/RelatedPosts.astro';

export interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  heroAlt?: string;
  productName: string;
  rating: number;
  usageDuration: string;
  productCategory: string;
  pros: string[];
  cons: string[];
  hasAffiliateLinks?: boolean;
  affiliateDisclaimer?: string;
  slug: string;
  tags?: string[];
  relatedSlugs?: string[];
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  heroImage,
  heroAlt,
  productName,
  rating,
  usageDuration,
  productCategory,
  pros,
  cons,
  hasAffiliateLinks = true,
  affiliateDisclaimer,
  slug,
  tags = [],
  relatedSlugs = [],
} = Astro.props;

const siteUrl = 'https://thebreakingdad.co.uk';
const canonicalUrl = `${siteUrl}/reviews/${slug}/`;

const categoryLabels: Record<string, string> = {
  'family-tech': 'Family tech',
  'parenting-kit': 'Parenting kit',
  'shoes-and-fitness': 'Shoes and fitness',
  'home-and-lifestyle': 'Home and lifestyle',
  'days-out': 'Days out',
};

const breadcrumbTrail = [
  { label: 'Home', href: '/' },
  { label: 'Reviews', href: '/reviews/' },
  { label: title, href: canonicalUrl },
];

// Review JSON-LD
const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: title,
  description,
  url: canonicalUrl,
  datePublished: publishDate.toISOString(),
  dateModified: (updatedDate ?? publishDate).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Dan Betts',
    url: `${siteUrl}/about/`,
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: rating,
    bestRating: 5,
    worstRating: 1,
  },
  itemReviewed: {
    '@type': 'Product',
    name: productName,
  },
  publisher: {
    '@type': 'Organization',
    name: 'The Breaking Dad',
    url: siteUrl,
  },
  ...(heroImage ? { image: heroImage.startsWith('http') ? heroImage : `${siteUrl}${heroImage}` } : {}),
};

// BreadcrumbList JSON-LD
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbTrail.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: item.href.startsWith('http') ? item.href : `${siteUrl}${item.href}`,
  })),
};

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(publishDate);

const formattedUpdatedDate = updatedDate
  ? new Intl.DateTimeFormat('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(updatedDate)
  : null;

// Star rendering helper
const filledStars = Math.round(rating);
const emptyStars = 5 - filledStars;

const defaultDisclaimer = `This review contains affiliate links, marked with *. If you buy through these links, I earn a small commission at no extra cost to you. I only recommend things I've actually used and genuinely rate. <a href="/affiliate-disclosure/">Full disclosure here</a>.`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={heroImage}
  ogType="article"
  publishDate={publishDate}
  updatedDate={updatedDate}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <article class="review-layout">
    <div class="container--narrow">
      <Breadcrumbs trail={breadcrumbTrail} />

      {heroImage && (
        <div class="review-layout__hero">
          <img src={heroImage} alt={heroAlt ?? title} width="720" height="405" loading="eager" />
        </div>
      )}

      <header class="review-layout__header">
        <div class="review-layout__meta">
          <a href="/reviews/" class="review-layout__category-tag">
            {categoryLabels[productCategory] ?? productCategory}
          </a>
          <time datetime={publishDate.toISOString()}>{formattedDate}</time>
          {formattedUpdatedDate && formattedUpdatedDate !== formattedDate && (
            <span class="review-layout__updated">Updated {formattedUpdatedDate}</span>
          )}
        </div>
        <h1 class="review-layout__title">{title}</h1>

        <div class="review-layout__rating-row">
          <div class="star-rating" aria-label={`Rating: ${rating} out of 5`}>
            {'★'.repeat(filledStars)}{'☆'.repeat(emptyStars)}
          </div>
          <span class="review-layout__rating-text">{rating}/5</span>
          <span class="review-layout__usage">· {usageDuration}</span>
        </div>
      </header>

      {hasAffiliateLinks && (
        <div class="affiliate-disclosure" role="note">
          <Fragment set:html={affiliateDisclaimer ?? defaultDisclaimer} />
        </div>
      )}

      <div class="pros-cons" aria-label="Pros and cons summary">
        <div class="pros-cons__col pros-cons__col--pros">
          <div class="pros-cons__heading">Pros</div>
          <ul class="pros-cons__list">
            {pros.map((pro) => <li>{pro}</li>)}
          </ul>
        </div>
        <div class="pros-cons__col pros-cons__col--cons">
          <div class="pros-cons__heading">Cons</div>
          <ul class="pros-cons__list">
            {cons.map((con) => <li>{con}</li>)}
          </ul>
        </div>
      </div>

      <div class="prose">
        <slot />
      </div>

      {hasAffiliateLinks && (
        <div class="affiliate-disclosure affiliate-disclosure--footer" role="note">
          <Fragment set:html={affiliateDisclaimer ?? defaultDisclaimer} />
        </div>
      )}

      <div class="review-layout__author-section">
        <AuthorBio variant="review" />
      </div>
    </div>

    {relatedSlugs.length > 0 && (
      <div class="review-layout__related">
        <div class="container">
          <RelatedPosts slugs={relatedSlugs} />
        </div>
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .review-layout {
    padding-block: 2rem 4rem;
  }

  .review-layout__hero {
    margin-bottom: 2rem;
    border-radius: 0.75rem;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .review-layout__hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
  }

  .review-layout__header {
    margin-bottom: 1.5rem;
  }

  .review-layout__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .review-layout__category-tag {
    display: inline-block;
    background: color-mix(in srgb, var(--color-highlight) 25%, var(--color-background));
    color: var(--color-text);
    border: 1px solid color-mix(in srgb, var(--color-highlight) 50%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: 2rem;
    font-weight: 500;
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .review-layout__category-tag:hover {
    text-decoration: none;
    background: color-mix(in srgb, var(--color-highlight) 40%, var(--color-background));
  }

  .review-layout__updated {
    font-style: italic;
  }

  .review-layout__title {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 0.875rem;
    color: var(--color-text);
  }

  .review-layout__rating-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    margin-bottom: 0.25rem;
  }

  .review-layout__rating-text {
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .review-layout__usage {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .affiliate-disclosure--footer {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .review-layout__author-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .review-layout__related {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 2px solid var(--color-border);
    background: var(--color-surface);
    padding-bottom: 3rem;
  }
</style>
