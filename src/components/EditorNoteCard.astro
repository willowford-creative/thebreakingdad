---
/**
 * Per-category editor's note. Sits beside <CategoryMasthead /> in a grid.
 *
 * Newsreader-italic pull-quote + author chip. Hides if no quote is supplied
 * (CMS may not have one yet for fresh categories).
 */

export interface Props {
  quote: string;
  authorName?: string;
  authorRole?: string;
  authorInitial?: string;
}

const {
  quote,
  authorName = 'Daniel Betts',
  authorRole = 'Writer, The Breaking Dad',
  authorInitial = 'D',
} = Astro.props;

if (!quote) return null;
---

<aside class="editor-note" aria-label={`Editor's note from ${authorName}`}>
  <div class="eyebrow eyebrow-accent editor-note__eyebrow">Editor's note</div>
  <p class="editor-note__quote">
    <em>&ldquo;{quote}&rdquo;</em>
  </p>
  <div class="editor-note__author">
    <img class="editor-note__avatar" src="/images/dan-betts-avatar.jpg" alt="" width="32" height="32" loading="lazy" />
    <div>
      <div class="editor-note__name">{authorName}</div>
      <div class="editor-note__role meta">{authorRole}</div>
    </div>
  </div>
</aside>

<style>
  .editor-note {
    background: var(--color-paper-tinted-2);
    border: 1px solid var(--color-accent-soft);
    border-radius: 12px;
    padding: 22px 24px;
  }

  .editor-note__eyebrow { margin-bottom: 8px; }

  .editor-note__quote {
    font-family: var(--font-sans);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-ink-2);
    margin: 0;
  }
  .editor-note__quote em {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-ink);
  }

  .editor-note__author {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--color-accent-soft);
  }

  .editor-note__avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 20%;
    display: block;
    flex-shrink: 0;
  }

  .editor-note__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    color: var(--color-ink);
  }
  .editor-note__role { font-size: 11px; }
</style>
