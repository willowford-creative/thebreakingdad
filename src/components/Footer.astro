---
const sectionsLinks = [
  { label: 'Parenting', href: '/parenting/' },
  { label: 'Separated parents', href: '/separated-parents/' },
  { label: 'Reviews', href: '/reviews/' },
  { label: 'Diary', href: '/diary/' },
];

const siteLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Work with us', href: '/work-with-us/' },
];

const legalLinks = [
  { label: 'Affiliate disclosure', href: '/affiliate-disclosure/' },
  { label: 'Privacy', href: '/privacy/' },
  { label: 'RSS', href: '/rss.xml' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="container">
      <div class="site-footer__grid">
        <div class="site-footer__brand">
          <a href="/" class="wordmark wordmark--lg" aria-label="The Breaking Dad — home">The Breaking Dad</a>
          <p class="site-footer__tagline">
            Honest writing from a UK dad — for parents, especially the ones doing it after separation.
            Co-parenting, blended family life, honest reviews. Written from Hampshire.
          </p>
          <div class="site-footer__socials">
            <a href="https://www.instagram.com/thebreakingdad" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                <rect x="2" y="2" width="12" height="12" rx="3"/>
                <circle cx="8" cy="8" r="2.5"/>
                <circle cx="11.5" cy="4.5" r="0.6" fill="currentColor"/>
              </svg>
            </a>
            <a href="https://www.facebook.com/thebreakingdad" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M9.5 14V8.5h1.8l.3-2.2H9.5V4.9c0-.6.2-1 1.1-1h1.2V1.9c-.2 0-.9-.1-1.7-.1-1.7 0-2.9 1-2.9 2.9v1.6H5.4v2.2h1.8V14h2.3z"/>
              </svg>
            </a>
            <a href="/contact/" aria-label="Email">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                <rect x="2" y="3" width="12" height="10" rx="1.5"/>
                <path d="m2.5 4.5 5.5 4 5.5-4"/>
              </svg>
            </a>
          </div>
        </div>

        <div>
          <div class="site-footer__col-h">Sections</div>
          <ul class="site-footer__links">
            {sectionsLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <div class="site-footer__col-h">The Site</div>
          <ul class="site-footer__links">
            {siteLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <div class="site-footer__col-h">Legal</div>
          <ul class="site-footer__links">
            {legalLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="site-footer__bottom">
        <p class="site-footer__copy">
          &copy; {year} The Breaking Dad. Written from Hampshire.
        </p>
        <p class="site-footer__disclaimer">
          Some links are affiliate. Recommendations are honest.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: #E8DDD7;
    margin-top: 64px;
  }

  .site-footer__inner {
    padding-block: 56px 28px;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 720px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 40px;
    }
  }

  /* Wordmark override for dark footer — handled in global.css */

  .site-footer__brand {
    max-width: 360px;
  }

  .site-footer__tagline {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
    margin: 14px 0 18px;
  }

  .site-footer__socials {
    display: flex;
    gap: 10px;
  }

  .site-footer__socials a {
    width: 32px; height: 32px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #E8DDD7;
    transition: border-color .15s, background .15s, color .15s;
  }

  .site-footer__socials a:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }

  .site-footer__col-h {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 14px;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .site-footer__links a {
    font-family: var(--font-sans);
    font-size: 14px;
    color: #E8DDD7;
    text-decoration: none;
    transition: color .15s;
  }

  .site-footer__links a:hover { color: #fff; }

  .site-footer__bottom {
    margin-top: 36px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (min-width: 720px) {
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .site-footer__copy,
  .site-footer__disclaimer {
    margin: 0;
    line-height: 1.6;
  }
</style>
