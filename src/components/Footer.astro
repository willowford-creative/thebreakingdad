---
const footerLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Work with us', href: '/work-with-us/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Privacy', href: '/privacy/' },
  { label: 'Affiliate disclosure', href: '/affiliate-disclosure/' },
  { label: 'RSS', href: '/rss.xml' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo">The Breaking Dad</a>
        <p class="site-footer__tagline">
          A UK dad writing about co-parenting, blended family life,
          and honest product reviews from Hampshire.
        </p>
      </div>

      <nav class="site-footer__nav" aria-label="Footer navigation">
        <ul class="site-footer__links">
          {footerLinks.map((link) => (
            <li>
              <a href={link.href} class="site-footer__link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="site-footer__social">
        <p class="site-footer__social-label">Follow</p>
        <a
          href="https://www.instagram.com/thebreakingdad"
          class="site-footer__instagram"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="The Breaking Dad on Instagram"
        >
          <!-- Instagram icon (inline SVG, no external request) -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
          </svg>
          @thebreakingdad
        </a>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">
        &copy; {year} The Breaking Dad. All rights reserved.
      </p>
      <p class="site-footer__disclaimer">
        Content on this site is for informational purposes only and does not constitute
        legal, financial, or professional advice.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-text);
    color: color-mix(in srgb, var(--color-background) 80%, transparent);
    padding-top: 3rem;
    padding-bottom: 2rem;
    margin-top: 4rem;
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .site-footer__top {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .site-footer__logo {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-background);
    text-decoration: none;
    display: block;
    margin-bottom: 0.75rem;
  }

  .site-footer__logo:hover {
    text-decoration: underline;
  }

  .site-footer__tagline {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-background) 60%, transparent);
    margin: 0;
  }

  .site-footer__nav {
    display: flex;
    flex-direction: column;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .site-footer__link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-background) 70%, transparent);
    text-decoration: none;
    transition: color 0.15s;
  }

  .site-footer__link:hover {
    color: var(--color-background);
    text-decoration: underline;
  }

  .site-footer__social-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-background) 50%, transparent);
    margin: 0 0 0.75rem;
  }

  .site-footer__instagram {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-background) 70%, transparent);
    text-decoration: none;
    transition: color 0.15s;
  }

  .site-footer__instagram:hover {
    color: var(--color-background);
    text-decoration: none;
  }

  .site-footer__bottom {
    border-top: 1px solid color-mix(in srgb, var(--color-background) 15%, transparent);
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .site-footer__copy,
  .site-footer__disclaimer {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--color-background) 45%, transparent);
    margin: 0;
    line-height: 1.6;
  }
</style>
