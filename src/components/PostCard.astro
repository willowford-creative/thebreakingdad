---
export interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
  imageAlt?: string;
  categoryLabel?: string;
  categoryHref?: string;
  date?: Date;
  rating?: number;
  variant?: 'default' | 'compact' | 'text';
}

const {
  title,
  description,
  href,
  image,
  imageAlt,
  categoryLabel,
  categoryHref,
  date,
  rating,
  variant = 'default',
} = Astro.props;

const formattedDate = date
  ? new Intl.DateTimeFormat('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    }).format(date)
  : null;

const filledStars = rating ? Math.round(rating) : 0;
const showImage = variant !== 'text' && image;

// Random illustration class for missing images (reproducible by slug)
const illusClasses = ['kids', 'review', 'frame', 'toys', 'travel', 'notes', 'window', 'sofa', 'car', 'book'];
function illusFor(seed: string): string {
  let h = 0;
  for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) | 0;
  return `illus--${illusClasses[Math.abs(h) % illusClasses.length]}`;
}
---

<a href={href} class={`card post-card post-card--${variant}`}>
  <div class="card__img-wrap">
    {showImage ? (
      <img
        src={image}
        alt={imageAlt ?? title}
        class="card__img"
        loading="lazy"
      />
    ) : (
      <div class={`card__img card__img--placeholder illus ${illusFor(href)}`} aria-hidden="true"></div>
    )}
  </div>
  <div class="card__body">
    {(categoryLabel || rating) && (
      <div class="card__meta-row">
        {categoryLabel && categoryHref ? (
          <a href={categoryHref} class="eyebrow eyebrow-accent" onclick="event.stopPropagation();">
            {categoryLabel}
          </a>
        ) : categoryLabel ? (
          <span class="eyebrow eyebrow-accent">{categoryLabel}</span>
        ) : null}
        {rating && (
          <span class="card__rating" aria-label={`${rating} out of 5`}>
            <span class="card__stars" aria-hidden="true">{'★'.repeat(filledStars)}{'☆'.repeat(5 - filledStars)}</span>
            <span class="card__score">{rating}/5</span>
          </span>
        )}
      </div>
    )}
    <h3 class="card-title">{title}</h3>
    {variant !== 'compact' && <p class="card-dek">{description}</p>}
    {formattedDate && (
      <span class="meta card__date">
        <time datetime={date?.toISOString()}>{formattedDate}</time>
      </span>
    )}
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  .card__img-wrap {
    aspect-ratio: 16/10;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-paper-2);
  }

  .card__img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .5s var(--ease-soft);
  }

  .post-card:hover .card__img { transform: scale(1.04); }

  .card__img--placeholder {
    width: 100%; height: 100%;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .card__meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.012em;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
    transition: color .15s;
    font-feature-settings: "ss01", "kern", "liga";
  }

  .post-card:hover .card-title { color: var(--color-accent); }

  .card-dek {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-ink-2);
    margin: 0;
  }

  .card__rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-sans);
  }

  .card__stars {
    color: var(--color-accent);
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .card__score {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-ink);
  }

  .card__date {
    font-size: 12.5px;
    margin-top: 2px;
  }

  /* Hover: subtle lift on whole card */
  .post-card {
    transition: transform .25s var(--ease-soft);
  }
  .post-card:hover { transform: translateY(-2px); }
</style>
