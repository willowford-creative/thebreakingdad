---
/**
 * Mid-page full-bleed pink newsletter band.
 * Variant of the homepage / inline newsletter — same ESP wiring (still
 * disabled until phase 2), per-category framing copy.
 */

export interface Props {
  /** Eyebrow above the headline */
  eyebrow?: string;
  /** Big headline */
  title?: string;
  /** Supporting paragraph; HTML allowed via slot for category emphasis */
  body?: string;
  /** Category name to use in the default body copy ("New {category} pieces…") */
  categoryLabel?: string;
  /** Social-proof / reassurance line under the form */
  reassurance?: string;
  /** CTA button label */
  cta?: string;
}

const {
  eyebrow = 'The Field Notes letter',
  title = 'One honest dispatch a fortnight. No filler.',
  body,
  categoryLabel,
  reassurance = '3,200+ UK parents · No spam · Unsubscribe in one click',
  cta = 'Subscribe',
} = Astro.props;

const defaultBody = categoryLabel
  ? `What we used this week, what worked, what didn't. Plus the new pieces in <strong>${categoryLabel}</strong> before they go live anywhere else.`
  : "What we used this week, what worked, what didn't. New pieces before they go live anywhere else.";
const bodyHtml = body ?? defaultBody;
---

<section class="section-pink category-newsletter" aria-label="Subscribe to the newsletter">
  <div class="category-newsletter__inner">
    <div class="eyebrow eyebrow-accent category-newsletter__eyebrow">{eyebrow}</div>
    <h2 class="category-newsletter__title">{title}</h2>
    <p class="category-newsletter__body" set:html={bodyHtml}></p>
    <form class="category-newsletter__form" onsubmit="event.preventDefault();">
      <label class="visually-hidden" for="category-newsletter-email">Email address</label>
      <input
        id="category-newsletter-email"
        class="input category-newsletter__input"
        type="email"
        placeholder="Email address"
        autocomplete="email"
        disabled
      />
      <button type="submit" class="btn" disabled title="Sign-up wired in phase 2">{cta}</button>
    </form>
    <div class="meta category-newsletter__reassurance">{reassurance}</div>
  </div>
</section>

<style>
  .category-newsletter__inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    padding-inline: 22px;
  }

  .category-newsletter__eyebrow {
    margin-bottom: 10px;
    justify-content: center;
    display: inline-flex;
  }

  .category-newsletter__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: -0.018em;
    color: var(--color-ink);
    margin: 0 0 12px;
    text-wrap: balance;
  }

  .category-newsletter__body {
    font-family: var(--font-sans);
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-ink-2);
    margin: 0 auto 22px;
    max-width: 560px;
  }
  .category-newsletter__body :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .category-newsletter__form {
    display: flex;
    gap: 10px;
    max-width: 460px;
    margin: 0 auto;
  }

  .category-newsletter__input {
    background: #fff;
    flex: 1;
  }

  .category-newsletter__form .btn { white-space: nowrap; }

  .category-newsletter__reassurance {
    font-size: 12px;
    margin-top: 12px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .category-newsletter__title { font-size: 24px; }
    .category-newsletter__body { font-size: 14.5px; }
    .category-newsletter__form { flex-direction: column; }
  }
</style>
