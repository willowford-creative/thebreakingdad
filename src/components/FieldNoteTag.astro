---
/**
 * Editorial issue-number tag (e.g. "Field Note · No. 64"). Issue number
 * defaults to months-since-launch (Jan 2021), or can be set manually via
 * frontmatter `issueNumber` for curated long-reads.
 */
export interface Props {
  number?: number;
  label?: string;
}

const { number, label = 'Field Note' } = Astro.props;

const issueNumber = number ?? (() => {
  const launch = new Date(2021, 0, 1);
  const now = new Date();
  return (now.getFullYear() - launch.getFullYear()) * 12 + (now.getMonth() - launch.getMonth());
})();
---

<div class="field-note-tag">
  <svg class="leaf" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5 19c0-7 5-13 14-14-1 9-7 14-14 14z" />
    <path d="M5 19c3-3 6-5 10-7" />
  </svg>
  <span>{label}</span>
  <span class="num">№ {issueNumber}</span>
</div>
