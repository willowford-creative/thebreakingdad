---
/**
 * Primary site header. Wordmark on the left, desktop nav inline, mobile nav
 * collapsed into a CSS-only `<details>` overlay (with a small inline script
 * mirroring `open` to `aria-expanded` for screen readers).
 */
const navLinks = [
  { label: 'Parenting', href: '/parenting/' },
  { label: 'Separated parents', href: '/separated-parents/' },
  { label: 'Reviews', href: '/reviews/' },
  { label: 'Diary', href: '/diary/' },
  { label: 'Work with us', href: '/work-with-us/' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="The Breaking Dad — home">
      <span class="wordmark">The Breaking Dad</span>
    </a>

    <nav class="site-nav site-nav--desktop" aria-label="Primary navigation">
      <ul class="site-nav__list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={`site-nav__link ${isActive(link.href) ? 'is-active' : ''}`}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button class="search" aria-label="Search (coming soon)" disabled title="Search coming soon">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="7" cy="7" r="5" />
          <path d="m11 11 3 3" stroke-linecap="round" />
        </svg>
      </button>

      <details class="site-nav site-nav--mobile" id="mobile-nav">
        <summary class="burger" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav-overlay">
          <span></span><span></span><span></span>
        </summary>
        <nav class="site-nav__overlay" id="mobile-nav-overlay" aria-label="Primary navigation">
          <div class="site-nav__overlay-inner">
            <span class="eyebrow">Sections</span>
            <ul class="site-nav__overlay-list">
              {navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class={`site-nav__overlay-link ${isActive(link.href) ? 'is-active' : ''}`}
                    aria-current={isActive(link.href) ? 'page' : undefined}
                  >
                    <span class="site-nav__overlay-label">{link.label}</span>
                    <span class="site-nav__overlay-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  // Mirror <details open> state to aria-expanded on the burger so screen
  // readers that don't infer state from <details> announce it correctly.
  (() => {
    const details = document.getElementById('mobile-nav');
    const summary = details?.querySelector('summary');
    if (!details || !summary) return;
    details.addEventListener('toggle', () => {
      summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');
      summary.setAttribute('aria-label', details.open ? 'Close menu' : 'Menu');
    });
  })();
</script>

<style>
  .site-header {
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: 22px;
    gap: 24px;
  }

  @media (max-width: 820px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      padding-block: 16px;
    }
  }

  .site-header__brand {
    display: inline-block;
    text-decoration: none;
    flex-shrink: 0;
    justify-self: start;
  }

  /* .wordmark styles live in global.css */

  /* Desktop nav (centre column) */
  .site-nav--desktop {
    display: none;
    justify-self: center;
  }

  @media (min-width: 820px) {
    .site-nav--desktop { display: block; }
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 13.5px;
    color: var(--color-ink);
    letter-spacing: -0.005em;
    position: relative;
    padding: 4px 0;
    text-decoration: none;
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    left: 0; right: 100%;
    bottom: -2px;
    height: 1.5px;
    background: var(--color-accent);
    transition: right .25s var(--ease-soft);
  }

  .site-nav__link:hover { color: var(--color-accent); }
  .site-nav__link:hover::after,
  .site-nav__link.is-active::after { right: 0; }
  .site-nav__link.is-active { color: var(--color-accent); }

  /* Right column — actions */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-self: end;
  }

  .search {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    cursor: pointer;
    transition: background .15s, border-color .15s;
    padding: 0;
  }

  .search:hover:not([disabled]) {
    background: var(--color-paper-tinted-2);
  }

  .search[disabled] {
    cursor: not-allowed;
    opacity: 0.7;
  }

  /* Mobile menu */
  .site-nav--mobile { position: relative; }

  @media (min-width: 820px) {
    .site-nav--mobile { display: none; }
  }

  .burger {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    cursor: pointer;
    list-style: none;
  }
  .burger::-webkit-details-marker { display: none; }
  .burger::marker { content: ""; }

  .burger span {
    display: block;
    width: 14px; height: 1.5px;
    background: var(--color-ink);
    border-radius: 1px;
    transition: transform 0.25s var(--ease-slide), opacity 0.2s;
  }

  /* Open-state rules live in global.css (Astro's scoper strips parent attribute selectors) */

  /* Mobile overlay (slide-down) */
  .site-nav__overlay {
    position: fixed;
    left: 0; right: 0; top: 0;
    background: var(--color-paper);
    transform: translateY(-100%);
    transition: transform .35s var(--ease-slide);
    z-index: 50;
    box-shadow: 0 18px 40px -12px rgba(0,0,0,0.22);
    border-bottom: 1px solid var(--color-rule);
    margin-top: 69px;
    max-height: calc(100vh - 69px);
    overflow-y: auto;
  }

  /* Open-state on .site-nav__overlay lives in global.css */

  .site-nav__overlay-inner {
    padding: 28px 22px 36px;
    max-width: var(--width-page);
    margin-inline: auto;
  }

  .site-nav__overlay-inner .eyebrow {
    display: block;
    margin-bottom: 14px;
  }

  .site-nav__overlay-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__overlay-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-rule-soft);
    text-decoration: none;
    gap: 12px;
  }

  .site-nav__overlay-list li:last-child .site-nav__overlay-link {
    border-bottom: none;
  }

  .site-nav__overlay-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.018em;
    color: var(--color-ink);
  }

  .site-nav__overlay-arrow {
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: 16px;
  }

  .site-nav__overlay-link.is-active .site-nav__overlay-label,
  .site-nav__overlay-link:hover .site-nav__overlay-label {
    color: var(--color-accent);
  }
</style>
