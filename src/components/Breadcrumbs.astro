---
/**
 * Visible breadcrumb trail. Schema.org BreadcrumbList JSON-LD is emitted
 * separately in the layout's head slot, not by this component.
 */
export interface BreadcrumbItem {
  label: string;
  href: string;
}

export interface Props {
  trail: BreadcrumbItem[];
}

const { trail } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list">
    {trail.map((item, i) => {
      const isLast = i === trail.length - 1;
      return (
        <li class="breadcrumbs__item">
          {isLast ? (
            <span aria-current="page" class="breadcrumbs__current">{item.label}</span>
          ) : (
            <>
              <a href={item.href} class="breadcrumbs__link">{item.label}</a>
              <span class="breadcrumbs__sep" aria-hidden="true">/</span>
            </>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-bottom: 1.25rem;
  }

  .breadcrumbs__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .breadcrumbs__item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .breadcrumbs__link {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .breadcrumbs__link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .breadcrumbs__sep {
    color: var(--color-border);
    user-select: none;
  }

  .breadcrumbs__current {
    color: var(--color-text);
    font-weight: 500;
    /* Truncate long post titles */
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: inline-block;
    vertical-align: middle;
  }
</style>
