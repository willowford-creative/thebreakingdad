---
/**
 * Diary index masthead — centered, 760px column.
 * Italic-Newsreader on the first phrase, sans on the rest.
 *
 * Matches design ref: tbd-diary.jsx DiaryIndexDesktop masthead.
 */

export interface Props {
  /** Italicised serif phrase, e.g. "Field notes," */
  italicLead: string;
  /** Sans-serif tail, e.g. "dated." */
  tail: string;
  /** Eyebrow above the headline */
  eyebrow?: string;
  /** Supporting paragraph */
  lede?: string;
  /** Meta line — entry count, since-date, cadence */
  meta?: string;
}

const {
  italicLead,
  tail,
  eyebrow = 'The Diary',
  lede,
  meta,
} = Astro.props;
---

<section class="diary-masthead">
  <div class="diary-masthead__inner">
    <div class="eyebrow eyebrow-accent diary-masthead__eyebrow">{eyebrow}</div>
    <h1 class="diary-masthead__title">
      <em>{italicLead}</em> {tail}
    </h1>
    {lede && <p class="lede diary-masthead__lede">{lede}</p>}
    {meta && <div class="meta diary-masthead__meta" set:html={meta} />}
  </div>
</section>

<style>
  .diary-masthead { padding: 56px 22px 40px; }
  .diary-masthead__inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .diary-masthead__eyebrow {
    margin-bottom: 16px;
    justify-content: center;
    display: inline-flex;
  }
  .diary-masthead__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, 6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin: 0 0 18px;
    text-wrap: balance;
  }
  .diary-masthead__title em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
  }
  .diary-masthead__lede {
    font-size: 19px;
    max-width: 560px;
    margin: 0 auto 22px;
  }
  .diary-masthead__meta { font-size: 12px; }
  @media (max-width: 640px) {
    .diary-masthead { padding: 32px 18px 20px; }
    .diary-masthead__lede { font-size: 16px; }
  }
</style>
