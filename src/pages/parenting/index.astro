---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import CategoryMasthead from '~/components/CategoryMasthead.astro';
import EditorNoteCard from '~/components/EditorNoteCard.astro';
import LeadPack from '~/components/LeadPack.astro';
import PillarTOC from '~/components/PillarTOC.astro';
import PillarGroup from '~/components/PillarGroup.astro';
import CategoryNewsletterBand from '~/components/CategoryNewsletterBand.astro';
import ArchiveFooter from '~/components/ArchiveFooter.astro';
import TopicChipStrip from '~/components/TopicChipStrip.astro';

// ---------------------------------------------------------------------------
// Per-category curated config — option B from the audit (inline in page).
// Migrate to a `categories` collection if a second editor needs to touch it.
// ---------------------------------------------------------------------------

const category = {
  slug: 'parenting',
  number: '01',
  title: 'Parenting',
  lede:
    "The skills, the philosophy, the bits nobody tells you. Field notes on raising kids, kit that earns its keep, and the family-life rhythms that actually hold.",
  cadence: 'Updated weekly',
  editorNote: {
    quote:
      "Most parenting writing flatters the parent. I try to write the bits I actually needed at 2am — the second-hand kit, the awkward conversations, the thing that worked the third time.",
    authorName: 'Daniel Betts',
    authorRole: 'Writer, The Breaking Dad',
    authorInitial: 'D',
  },
  /** Editor-curated lead pack. Slugs resolve against the `parenting` collection.
   *  Falls back to most-recent if any slug is missing.
   */
  startHere: {
    heroSlug: '',         // empty → falls back to most-recent
    supportingSlugs: [],  // empty → falls back to next-most-recent two
  },
};

const pillars = [
  {
    slug: 'raising-kids',
    title: 'Raising kids',
    dek: 'The skills, the philosophy, the bits nobody tells you.',
    /** Editor-curated featured slugs; empty → most-recent in pillar */
    featuredSlugs: [] as string[],
    /** "Denser" pillars can show 4 cards instead of 3 */
    cardLimit: 3,
  },
  {
    slug: 'kit-and-gear',
    title: 'Kit & gear',
    dek: 'Gift guides, newborn essentials, honest picks from people who own kids.',
    featuredSlugs: [],
    cardLimit: 4,
  },
  {
    slug: 'family-life',
    title: 'Family life',
    dek: 'Sustainability, crafts, rituals, and the weekend bits that hold it together.',
    featuredSlugs: [],
    cardLimit: 3,
  },
  {
    slug: 'days-out',
    title: 'Days out',
    dek: 'Family activities — local, occasional, and genuinely worth the trip.',
    featuredSlugs: [],
    cardLimit: 3,
  },
  {
    slug: 'digital-parenting',
    title: 'Digital parenting',
    dek: "AI, screens, social, and the tech conversations modern parents can't avoid.",
    featuredSlugs: [],
    cardLimit: 3,
  },
] as const;

// ---------------------------------------------------------------------------
// Data load
// ---------------------------------------------------------------------------

const allEntries = await getCollection('parenting', ({ data }) => !data.draft);
const sorted = allEntries.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const slugOf = (entry: (typeof sorted)[number]) => entry.id.replace(/\.(md|mdx)$/, '');
const bySlug = new Map(sorted.map((e) => [slugOf(e), e]));
const topicLabel = Object.fromEntries(pillars.map((p) => [p.slug, p.title]));

// Map a content entry → the shape our card components expect.
const toPostRef = (entry: (typeof sorted)[number]) => {
  const slug = slugOf(entry);
  return {
    title: entry.data.title,
    description: entry.data.description,
    href: `/parenting/${slug}/`,
    image: entry.data.heroImage,
    imageAlt: entry.data.heroAlt,
    date: entry.data.publishDate,
    categoryLabel: topicLabel[entry.data.topic] ?? entry.data.topic,
    categoryHref: `/parenting/#${entry.data.topic}`,
  };
};

// Resolve a curated slug list, padding with the most-recent in pillar.
function resolveFeatured(pillarSlug: string, curated: string[], limit: number) {
  const inPillar = sorted.filter((e) => e.data.topic === pillarSlug);
  const seen = new Set<string>();
  const out: ReturnType<typeof toPostRef>[] = [];

  for (const slug of curated) {
    const entry = bySlug.get(slug);
    if (entry && !seen.has(slug)) {
      out.push(toPostRef(entry));
      seen.add(slug);
    }
    if (out.length >= limit) break;
  }
  for (const entry of inPillar) {
    if (out.length >= limit) break;
    const slug = slugOf(entry);
    if (seen.has(slug)) continue;
    out.push(toPostRef(entry));
    seen.add(slug);
  }
  return out;
}

// Lead pack — same logic, drawing from any topic.
function resolveLeadPack() {
  const seen = new Set<string>();
  const heroSlug = category.startHere.heroSlug;
  let hero = heroSlug ? bySlug.get(heroSlug) : undefined;
  if (!hero) hero = sorted[0];
  if (hero) seen.add(slugOf(hero));

  const supporting: typeof sorted = [];
  for (const slug of category.startHere.supportingSlugs) {
    const entry = bySlug.get(slug);
    if (entry && !seen.has(slug)) {
      supporting.push(entry);
      seen.add(slug);
    }
    if (supporting.length >= 2) break;
  }
  for (const entry of sorted) {
    if (supporting.length >= 2) break;
    const slug = slugOf(entry);
    if (seen.has(slug)) continue;
    supporting.push(entry);
    seen.add(slug);
  }
  return { hero, supporting };
}

const lead = resolveLeadPack();

// Pillar TOC items (counts driven by actual collection)
const tocItems = pillars.map((p) => ({
  slug: p.slug,
  title: p.title,
  dek: p.dek,
  count: sorted.filter((e) => e.data.topic === p.slug).length,
}));

// Pillar groups — featured posts resolved per pillar
const pillarGroups = pillars.map((p) => ({
  ...p,
  items: resolveFeatured(p.slug, [...p.featuredSlugs], p.cardLimit),
}));

const totalPieces = sorted.length;

// Year tallies for the archive footer
const yearMap = new Map<number, number>();
for (const e of sorted) {
  const y = e.data.publishDate.getFullYear();
  yearMap.set(y, (yearMap.get(y) ?? 0) + 1);
}
const years = Array.from(yearMap, ([year, count]) => ({ year, count }));

// Active year from ?year=YYYY (Astro is static; we render server-side from the
// URL at build, so the active state surfaces on /parenting/?year=2026 etc.)
const activeYearParam = Astro.url.searchParams.get('year');
const activeYear = activeYearParam ? Number(activeYearParam) : undefined;

// Mobile chip strip items — anchor to the matching pillar group
const chipItems = pillars.map((p) => ({ label: p.title, href: `/parenting/#${p.slug}` }));
---

<BaseLayout
  title={`${category.title} — The Breaking Dad`}
  description={category.lede}
>
  <div class="container">
    <div class="cat-breadcrumb-row">
      <Breadcrumbs trail={[
        { label: 'Home', href: '/' },
        { label: category.title, href: '/parenting/' },
      ]} />
    </div>
  </div>

  <section class="container cat-masthead-section" aria-label={`${category.title} introduction`}>
    <div class="cat-masthead-grid">
      <CategoryMasthead
        number={category.number}
        title={category.title}
        lede={category.lede}
        pieceCount={totalPieces}
        cadence={category.cadence}
        pillarCount={pillars.length}
      />
      <EditorNoteCard
        quote={category.editorNote.quote}
        authorName={category.editorNote.authorName}
        authorRole={category.editorNote.authorRole}
        authorInitial={category.editorNote.authorInitial}
      />
    </div>
  </section>

  <div class="container cat-chip-row">
    <TopicChipStrip allHref="/parenting/" items={chipItems} />
  </div>

  {lead.hero && (
    <section class="container cat-section" aria-label="Start here">
      <header class="cat-section__head">
        <div>
          <div class="eyebrow eyebrow-accent cat-section__eyebrow">Start here</div>
          <h2 class="cat-section__title">The ones to read first</h2>
        </div>
        <span class="meta">A short starter set across the topics</span>
      </header>
      <LeadPack
        hero={toPostRef(lead.hero)}
        supporting={lead.supporting.map(toPostRef)}
      />
    </section>
  )}

  <section class="container cat-section" aria-label="Browse by topic">
    <header class="cat-section__head">
      <div>
        <div class="eyebrow eyebrow-accent cat-section__eyebrow">Browse by topic</div>
        <h2 class="cat-section__title">{pillars.length} threads that run through everything here</h2>
      </div>
      <span class="meta">Jump to any section ↓</span>
    </header>
    <PillarTOC items={tocItems} />
  </section>

  {/*
    Render the first half of the pillars, then the newsletter band, then the rest.
    Mid-page placement matches the design's pacing.
  */}
  {pillarGroups.slice(0, 2).map((p) => (
    <div class="container">
      <PillarGroup
        slug={p.slug}
        title={p.title}
        eyebrow={p.title}
        dek={p.dek}
        moreHref={`/parenting/?pillar=${p.slug}`}
        items={p.items}
      />
    </div>
  ))}

  <CategoryNewsletterBand categoryLabel={category.title} />

  {pillarGroups.slice(2).map((p) => (
    <div class="container">
      <PillarGroup
        slug={p.slug}
        title={p.title}
        eyebrow={p.title}
        dek={p.dek}
        moreHref={`/parenting/?pillar=${p.slug}`}
        items={p.items}
      />
    </div>
  ))}

  <section class="container cat-archive-section" aria-label={`${category.title} archive`}>
    <ArchiveFooter
      categoryLabel={category.title}
      totalPieces={totalPieces}
      archiveHref="/parenting/archive/"
      searchHref="/search/?in=parenting"
      years={years}
      activeYear={activeYear}
      yearBaseHref="/parenting/"
    />
  </section>

  {sorted.length === 0 && (
    <section class="container">
      <p class="cat-empty">Parenting posts are coming soon.</p>
    </section>
  )}
</BaseLayout>

<style>
  .cat-breadcrumb-row {
    padding: 14px 0;
    border-bottom: 1px solid var(--color-rule-soft);
  }

  .cat-masthead-section {
    padding-block: 44px 28px;
  }

  .cat-masthead-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: end;
  }

  .cat-chip-row {
    /* TopicChipStrip handles its own bleed + display:none on desktop */
    padding-block: 0;
  }

  .cat-section {
    padding-block: 20px 0;
  }
  .cat-section + .cat-section { padding-top: 64px; }

  .cat-section__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 22px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-rule);
    gap: 24px;
    flex-wrap: wrap;
  }
  .cat-section__eyebrow { margin-bottom: 6px; }
  .cat-section__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    letter-spacing: -0.018em;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }

  .cat-archive-section {
    padding-block: 80px;
  }

  .cat-empty {
    font-family: var(--font-sans);
    color: var(--color-ink-3);
    padding-block: 40px;
  }

  @media (max-width: 768px) {
    .cat-masthead-section { padding-block: 26px 20px; }
    .cat-masthead-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .cat-section + .cat-section { padding-top: 40px; }
    .cat-section__title { font-size: 22px; }
    .cat-archive-section { padding-block: 48px; }
  }
</style>
