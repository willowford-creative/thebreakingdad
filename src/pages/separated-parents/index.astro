---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import CategoryMasthead from '~/components/CategoryMasthead.astro';
import EditorNoteCard from '~/components/EditorNoteCard.astro';
import LeadPack from '~/components/LeadPack.astro';
import PillarTOC from '~/components/PillarTOC.astro';
import PillarGroup from '~/components/PillarGroup.astro';
import CategoryNewsletterBand from '~/components/CategoryNewsletterBand.astro';
import ArchiveFooter from '~/components/ArchiveFooter.astro';
import TopicChipStrip from '~/components/TopicChipStrip.astro';

// ---------------------------------------------------------------------------
// Per-category curated config
// ---------------------------------------------------------------------------

const category = {
  slug: 'separated-parents',
  number: '02',
  title: 'Separated parents',
  lede:
    "Practical, honest writing about life after separation — co-parenting, blended family life, the benefits system, the legal stuff, and starting over. Written from eight years of lived experience, not a textbook.",
  cadence: 'Updated weekly',
  editorNote: {
    quote:
      "I started writing this section because every guide I read sounded like it was written by someone who'd never had to call CMS at 8am. The bits I needed were the ones nobody admits to.",
    authorName: 'Daniel Betts',
    authorRole: 'Writer, The Breaking Dad',
    authorInitial: 'D',
  },
  startHere: {
    heroSlug: '',
    supportingSlugs: [] as string[],
  },
};

const pillars = [
  {
    slug: 'co-parenting',
    title: 'Co-parenting',
    dek: 'Parenting plans, schedules, mediation, and what to do when it gets hard.',
    featuredSlugs: [] as string[],
    cardLimit: 3,
  },
  {
    slug: 'blended-family',
    title: 'Blended family',
    dek: 'Introducing new partners, step-parenting, the chaos and the joy of a bigger family.',
    featuredSlugs: [] as string[],
    cardLimit: 3,
  },
  {
    slug: 'money-and-benefits',
    title: 'Money and benefits',
    dek: 'Universal Credit, child maintenance, grants, and making the numbers work.',
    featuredSlugs: [] as string[],
    cardLimit: 4,
  },
  {
    slug: 'rights-and-law',
    title: 'Rights and law',
    dek: "Child arrangements, primary carer rights, CMS, and what your options really are.",
    featuredSlugs: [] as string[],
    cardLimit: 3,
  },
  {
    slug: 'starting-over',
    title: 'Starting over',
    dek: 'Dating again, rebuilding your identity, and the emotional side of separation.',
    featuredSlugs: [] as string[],
    cardLimit: 3,
  },
] as const;

// ---------------------------------------------------------------------------
// Data load — `posts` collection, keyed by `subhub`
// ---------------------------------------------------------------------------

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sorted = allPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const slugOf = (entry: (typeof sorted)[number]) => entry.id.replace(/\.(md|mdx)$/, '');
const bySlug = new Map(sorted.map((e) => [slugOf(e), e]));
const subhubLabel = Object.fromEntries(pillars.map((p) => [p.slug, p.title]));

const toPostRef = (entry: (typeof sorted)[number]) => {
  const slug = slugOf(entry);
  return {
    title: entry.data.title,
    description: entry.data.description,
    href: `/separated-parents/${slug}/`,
    image: entry.data.heroImage,
    imageAlt: entry.data.heroAlt,
    date: entry.data.publishDate,
    categoryLabel: subhubLabel[entry.data.subhub] ?? entry.data.subhub,
    categoryHref: `/separated-parents/${entry.data.subhub}/`,
  };
};

function resolveFeatured(pillarSlug: string, curated: string[], limit: number) {
  const inPillar = sorted.filter((e) => e.data.subhub === pillarSlug);
  const seen = new Set<string>();
  const out: ReturnType<typeof toPostRef>[] = [];

  for (const slug of curated) {
    const entry = bySlug.get(slug);
    if (entry && !seen.has(slug)) {
      out.push(toPostRef(entry));
      seen.add(slug);
    }
    if (out.length >= limit) break;
  }
  for (const entry of inPillar) {
    if (out.length >= limit) break;
    const slug = slugOf(entry);
    if (seen.has(slug)) continue;
    out.push(toPostRef(entry));
    seen.add(slug);
  }
  return out;
}

function resolveLeadPack() {
  const seen = new Set<string>();
  const heroSlug = category.startHere.heroSlug;
  let hero = heroSlug ? bySlug.get(heroSlug) : undefined;
  if (!hero) hero = sorted[0];
  if (hero) seen.add(slugOf(hero));

  const supporting: typeof sorted = [];
  for (const slug of category.startHere.supportingSlugs) {
    const entry = bySlug.get(slug);
    if (entry && !seen.has(slug)) {
      supporting.push(entry);
      seen.add(slug);
    }
    if (supporting.length >= 2) break;
  }
  for (const entry of sorted) {
    if (supporting.length >= 2) break;
    const slug = slugOf(entry);
    if (seen.has(slug)) continue;
    supporting.push(entry);
    seen.add(slug);
  }
  return { hero, supporting };
}

const lead = resolveLeadPack();

const tocItems = pillars.map((p) => ({
  slug: p.slug,
  title: p.title,
  dek: p.dek,
  count: sorted.filter((e) => e.data.subhub === p.slug).length,
}));

const pillarGroups = pillars.map((p) => ({
  ...p,
  items: resolveFeatured(p.slug, [...p.featuredSlugs], p.cardLimit),
}));

const totalPieces = sorted.length;

const yearMap = new Map<number, number>();
for (const e of sorted) {
  const y = e.data.publishDate.getFullYear();
  yearMap.set(y, (yearMap.get(y) ?? 0) + 1);
}
const years = Array.from(yearMap, ([year, count]) => ({ year, count }));

const activeYearParam = Astro.url.searchParams.get('year');
const activeYear = activeYearParam ? Number(activeYearParam) : undefined;

// Subhubs have their own routes, so chips link to those instead of in-page anchors
const chipItems = pillars.map((p) => ({ label: p.title, href: `/separated-parents/${p.slug}/` }));
---

<BaseLayout
  title={`${category.title} — co-parenting, blended families, rights and money`}
  description={category.lede}
>
  <div class="container">
    <div class="cat-breadcrumb-row">
      <Breadcrumbs trail={[
        { label: 'Home', href: '/' },
        { label: category.title, href: '/separated-parents/' },
      ]} />
    </div>
  </div>

  <section class="container cat-masthead-section" aria-label={`${category.title} introduction`}>
    <div class="cat-masthead-grid">
      <CategoryMasthead
        number={category.number}
        title={category.title}
        lede={category.lede}
        pieceCount={totalPieces}
        cadence={category.cadence}
        pillarCount={pillars.length}
      />
      <EditorNoteCard
        quote={category.editorNote.quote}
        authorName={category.editorNote.authorName}
        authorRole={category.editorNote.authorRole}
        authorInitial={category.editorNote.authorInitial}
      />
    </div>
  </section>

  <div class="container cat-chip-row">
    <TopicChipStrip allHref="/separated-parents/" items={chipItems} />
  </div>

  {lead.hero && (
    <section class="container cat-section" aria-label="Start here">
      <header class="cat-section__head">
        <div>
          <div class="eyebrow eyebrow-accent cat-section__eyebrow">Start here</div>
          <h2 class="cat-section__title">The ones to read first</h2>
        </div>
        <span class="meta">If you're new, these three pieces help most</span>
      </header>
      <LeadPack
        hero={toPostRef(lead.hero)}
        supporting={lead.supporting.map(toPostRef)}
      />
    </section>
  )}

  <section class="container cat-section" aria-label="Browse by topic">
    <header class="cat-section__head">
      <div>
        <div class="eyebrow eyebrow-accent cat-section__eyebrow">Browse by topic</div>
        <h2 class="cat-section__title">{pillars.length} threads that run through everything here</h2>
      </div>
      <span class="meta">Jump to any sub-hub →</span>
    </header>
    <PillarTOC items={tocItems} />
  </section>

  {pillarGroups.slice(0, 2).map((p) => (
    <div class="container">
      <PillarGroup
        slug={p.slug}
        title={p.title}
        eyebrow={p.title}
        dek={p.dek}
        moreHref={`/separated-parents/${p.slug}/`}
        items={p.items}
      />
    </div>
  ))}

  <CategoryNewsletterBand categoryLabel={category.title} />

  {pillarGroups.slice(2).map((p) => (
    <div class="container">
      <PillarGroup
        slug={p.slug}
        title={p.title}
        eyebrow={p.title}
        dek={p.dek}
        moreHref={`/separated-parents/${p.slug}/`}
        items={p.items}
      />
    </div>
  ))}

  <section class="container cat-archive-section" aria-label={`${category.title} archive`}>
    <ArchiveFooter
      categoryLabel={category.title}
      totalPieces={totalPieces}
      archiveHref="/separated-parents/archive/"
      searchHref="/search/?in=separated-parents"
      years={years}
      activeYear={activeYear}
      yearBaseHref="/separated-parents/"
    />
  </section>

  {sorted.length === 0 && (
    <section class="container">
      <p class="cat-empty">Posts are coming soon.</p>
    </section>
  )}
</BaseLayout>

<style>
  .cat-breadcrumb-row {
    padding: 14px 0;
    border-bottom: 1px solid var(--color-rule-soft);
  }

  .cat-masthead-section {
    padding-block: 44px 28px;
  }

  .cat-masthead-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: end;
  }

  .cat-chip-row { padding-block: 0; }

  .cat-section { padding-block: 20px 0; }
  .cat-section + .cat-section { padding-top: 64px; }

  .cat-section__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 22px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-rule);
    gap: 24px;
    flex-wrap: wrap;
  }
  .cat-section__eyebrow { margin-bottom: 6px; }
  .cat-section__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    letter-spacing: -0.018em;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }

  .cat-archive-section { padding-block: 80px; }

  .cat-empty {
    font-family: var(--font-sans);
    color: var(--color-ink-3);
    padding-block: 40px;
  }

  @media (max-width: 768px) {
    .cat-masthead-section { padding-block: 26px 20px; }
    .cat-masthead-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .cat-section + .cat-section { padding-top: 40px; }
    .cat-section__title { font-size: 22px; }
    .cat-archive-section { padding-block: 48px; }
  }
</style>
