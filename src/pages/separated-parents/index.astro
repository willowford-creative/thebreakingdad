---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PillarHeader from '~/components/PillarHeader.astro';
import SectionTitle from '~/components/SectionTitle.astro';
import PostCard from '~/components/PostCard.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const subhubs = [
  {
    slug: 'co-parenting',
    label: 'Co-parenting',
    description: 'Parenting plans, schedules, mediation, and what to do when it gets hard.',
  },
  {
    slug: 'blended-family',
    label: 'Blended family',
    description: 'Introducing new partners, step-parenting, the chaos and the joy of a bigger family.',
  },
  {
    slug: 'money-and-benefits',
    label: 'Money and benefits',
    description: 'Universal Credit, child maintenance, grants, and making the numbers work.',
  },
  {
    slug: 'rights-and-law',
    label: 'Rights and law',
    description: 'Child arrangements, primary carer rights, CMS, and what your options really are.',
  },
  {
    slug: 'starting-over',
    label: 'Starting over',
    description: 'Dating again, rebuilding your identity, and the emotional side of separation.',
  },
];

const subhubLabels: Record<string, string> = Object.fromEntries(
  subhubs.map((s) => [s.slug, s.label])
);

// Count posts per subhub
const subhubCounts: Record<string, number> = {};
for (const p of sortedPosts) {
  subhubCounts[p.data.subhub] = (subhubCounts[p.data.subhub] ?? 0) + 1;
}

const cornerstone = sortedPosts.slice(0, 3);
const recent = sortedPosts.slice(0, 8);
---

<BaseLayout
  title="Separated parents — co-parenting, blended families, rights and money"
  description="Practical, honest guides for separated parents in the UK — co-parenting, blended family life, benefits, legal rights, and starting over. Written by Dan Betts."
>
  <PillarHeader
    kicker="The Pillar"
    title="Separated parents"
    dek="Practical, honest writing about life after separation — co-parenting, blended family life, the benefits system, the legal stuff, and starting over. Written from eight years of lived experience, not a textbook."
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Separated parents', href: '/separated-parents/' },
    ]}
  />

  {cornerstone.length > 0 && (
    <section class="home-section" aria-label="Start here">
      <div class="container">
        <SectionTitle
          kicker="Start here"
          title="The ones to read first"
          subtitle="If you're new, these are the three pieces that most people find helpful."
        />
        <div class="card-grid card-grid--3">
          {cornerstone.map((post) => {
            const slugId = post.id.replace(/\.(md|mdx)$/, '');
            return (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                href={`/separated-parents/${slugId}/`}
                image={post.data.heroImage}
                imageAlt={post.data.heroAlt}
                categoryLabel={subhubLabels[post.data.subhub] ?? post.data.subhub}
                categoryHref={`/separated-parents/${post.data.subhub}/`}
                date={post.data.publishDate}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="home-section home-section--tinted" aria-label="Browse by topic">
    <div class="container">
      <SectionTitle kicker="Browse by topic" />
      <ol class="subhub-list">
        {subhubs.map((hub, i) => (
          <li class="subhub-item">
            <a href={`/separated-parents/${hub.slug}/`} class="subhub-item__link">
              <span class="subhub-item__number">{String(i + 1).padStart(2, '0')}</span>
              <div class="subhub-item__body">
                <h3 class="subhub-item__title">{hub.label}</h3>
                <p class="subhub-item__description">{hub.description}</p>
              </div>
              <span class="subhub-item__count">
                {subhubCounts[hub.slug] ?? 0} {(subhubCounts[hub.slug] ?? 0) === 1 ? 'piece' : 'pieces'}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {recent.length > 0 && (
    <section class="home-section" aria-label="Recent posts">
      <div class="container">
        <SectionTitle
          kicker="Recent"
          moreHref="/separated-parents/"
          moreLabel="View all"
        />
        <div class="card-grid card-grid--4">
          {recent.map((post) => {
            const slugId = post.id.replace(/\.(md|mdx)$/, '');
            return (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                href={`/separated-parents/${slugId}/`}
                image={post.data.heroImage}
                imageAlt={post.data.heroAlt}
                categoryLabel={subhubLabels[post.data.subhub] ?? post.data.subhub}
                categoryHref={`/separated-parents/${post.data.subhub}/`}
                date={post.data.publishDate}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .home-section {
    padding-block: 2.75rem;
  }

  .home-section--tinted {
    background: var(--color-surface);
  }

  .subhub-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-hairline);
  }

  .subhub-item {
    border-bottom: 1px solid var(--color-hairline);
  }

  .subhub-item__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.5rem 0;
    text-decoration: none;
    transition: padding 0.2s ease;
  }

  @media (max-width: 560px) {
    .subhub-item__link {
      grid-template-columns: auto 1fr;
      gap: 1rem;
    }
    .subhub-item__count {
      grid-column: 2;
      justify-self: start;
      margin-top: 0.25rem;
    }
  }

  .subhub-item__link:hover {
    padding-left: 0.5rem;
    background: color-mix(in srgb, var(--color-accent) 4%, transparent);
  }

  .subhub-item__number {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    font-feature-settings: "tnum";
    padding-top: 0.375rem;
  }

  .subhub-item__body {
    display: grid;
    gap: 0.375rem;
  }

  .subhub-item__title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-text);
    transition: color 0.15s;
  }

  .subhub-item__link:hover .subhub-item__title {
    color: var(--color-accent);
  }

  .subhub-item__description {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0;
    max-width: 52ch;
  }

  .subhub-item__count {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
</style>
