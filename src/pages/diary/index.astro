---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PillarHeader from '~/components/PillarHeader.astro';

const allDiary = await getCollection('diary', ({ data }) => !data.draft);
const sortedDiary = allDiary.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout
  title="Diary — personal writing from The Breaking Dad"
  description="Personal pieces from Dan Betts — voice, reflection, and the real day-to-day of life as a dad. Not SEO. Just honest writing."
>
  <PillarHeader
    kicker="The Diary"
    title="Writing without a brief"
    dek="This is where I write without SEO targets or keyword research. Just the real day-to-day of being a dad — the brilliant bits, the hard bits, the bits that are difficult to explain unless you've been there."
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Diary', href: '/diary/' },
    ]}
  />

  <section class="home-section" aria-label="All diary entries">
    <div class="container--narrow">
      {sortedDiary.length === 0 ? (
        <p class="diary-empty">Diary entries are coming soon.</p>
      ) : (
        <ol class="diary-list">
          {sortedDiary.map((entry) => {
            const slugId = entry.id.replace(/\.(md|mdx)$/, '');
            const formattedDate = new Intl.DateTimeFormat('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            }).format(entry.data.publishDate);

            return (
              <li class="diary-entry">
                <time class="diary-entry__date" datetime={entry.data.publishDate.toISOString()}>
                  {formattedDate}
                </time>
                <h2 class="diary-entry__title">
                  <a href={`/diary/${slugId}/`} class="diary-entry__link">
                    {entry.data.title}
                  </a>
                </h2>
                {entry.data.description && (
                  <p class="diary-entry__description">{entry.data.description}</p>
                )}
              </li>
            );
          })}
        </ol>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .home-section {
    padding-block: 2.75rem 4rem;
  }

  .diary-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-hairline);
  }

  .diary-entry {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .diary-entry__date {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .diary-entry__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }

  .diary-entry__link {
    color: var(--color-text);
    text-decoration: none;
  }

  .diary-entry__link:hover {
    color: var(--color-accent);
  }

  .diary-entry__description {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0;
    max-width: 56ch;
  }

  .diary-empty {
    font-family: var(--font-sans);
    color: var(--color-muted);
  }
</style>
