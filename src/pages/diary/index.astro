---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import DiaryMasthead from '~/components/DiaryMasthead.astro';
import DiaryRow from '~/components/DiaryRow.astro';
import CategoryNewsletterBand from '~/components/CategoryNewsletterBand.astro';
import { getDiaryAuditResults } from '~/utils/diaryAudit';
import { groupByMonth, countByYear, peekFromEntry } from '~/utils/diaryGroup';

// Run gates first — fails the build on hard errors, writes the audit log.
const auditResults = await getDiaryAuditResults();

const allDiary = await getCollection('diary', ({ data }) => !data.draft);
const groups = groupByMonth(allDiary);
const yearCounts = countByYear(allDiary);
const total = allDiary.length;

const oldestYear =
  yearCounts.length > 0 ? yearCounts[yearCounts.length - 1].year : null;
const sinceLabel = oldestYear
  ? `Since ${new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' }).format(
      new Date(oldestYear, 0, 1),
    )}`
  : 'New section';

const metaParts = [
  `<strong>${total}</strong> ${total === 1 ? 'entry' : 'entries'}`,
  sinceLabel,
  'New entries most weeks',
];
const metaHtml = metaParts.join(' · ');

const breadcrumbTrail = [
  { label: 'Home', href: '/' },
  { label: 'Diary', href: '/diary/' },
];

// Lookup to skip rendering rows that errored — should be impossible at this
// point (build would have failed) but defensive.
const erroredSlugs = new Set(
  auditResults.filter((r) => r.errors.length > 0).map((r) => r.slug),
);
---

<BaseLayout
  title="The Diary — field notes, dated"
  description="Shorter, more personal pieces from Dan Betts. Less guide, more journal — the things I noticed, the bits I'm still working out."
  ogType="website"
>
  <div class="diary-index__crumb-row">
    <div class="container--narrow">
      <Breadcrumbs trail={breadcrumbTrail} />
    </div>
  </div>

  <DiaryMasthead
    italicLead="Field notes,"
    tail="dated."
    lede="Shorter, more personal pieces. Less guide, more journal — what the week actually looked like, the things I noticed, the bits I'm still working out."
    meta={metaHtml}
  />

  {yearCounts.length > 0 && (
    <nav class="diary-year-rail" aria-label="Filter by year">
      <a href="/diary/" class="diary-year-pill is-active">
        All <span class="diary-year-pill__count">({total})</span>
      </a>
      {yearCounts.map(({ year, count }) => (
        <a href={`/diary/years/${year}/`} class="diary-year-pill">
          {year} <span class="diary-year-pill__count">({count})</span>
        </a>
      ))}
    </nav>
  )}

  <section class="diary-index__timeline" aria-label="Diary timeline">
    {total === 0 ? (
      <p class="diary-index__empty">
        Diary entries are coming soon. The first one's nearly written.
      </p>
    ) : (
      groups.map((group) => (
        <div class="diary-index__group">
          <div class="diary-month-label">
            <h2>{group.label}</h2>
            <span class="diary-month-label__count">
              {group.entries.length} {group.entries.length === 1 ? 'entry' : 'entries'}
            </span>
          </div>
          {group.entries
            .filter((e) => !erroredSlugs.has(e.id.replace(/\.(md|mdx)$/, '')))
            .map((entry) => {
              const slug = entry.id.replace(/\.(md|mdx)$/, '');
              const result = auditResults.find((r) => r.slug === slug);
              return (
                <DiaryRow
                  href={`/diary/${slug}/`}
                  date={entry.data.publishDate}
                  title={entry.data.title}
                  dek={entry.data.lede ?? entry.data.description}
                  readMinutes={result?.readMinutes ?? 1}
                  peek={peekFromEntry(entry)}
                />
              );
            })}
        </div>
      ))
    )}

    {total > 0 && (
      <div class="diary-index__archive">
        <a href="/diary/archive/" class="btn ghost diary-index__archive-btn">
          Browse the full archive
        </a>
      </div>
    )}
  </section>

  <CategoryNewsletterBand
    eyebrow="Get diary entries by email"
    title="The Field Notes letter"
    body="One honest dispatch a fortnight. Diary entries, what we used this week, what worked, what didn't."
  />
</BaseLayout>

<style>
  .diary-index__crumb-row {
    border-bottom: 1px solid var(--color-rule-soft);
    padding-block: 14px;
  }

  .diary-index__timeline {
    max-width: 880px;
    margin: 0 auto;
    padding: 32px 22px 64px;
    position: relative;
  }

  .diary-index__group + .diary-index__group { margin-top: 12px; }

  .diary-index__empty {
    font-family: var(--font-sans);
    color: var(--color-ink-3);
    text-align: center;
    padding: 32px 0;
  }

  .diary-index__archive {
    display: flex;
    justify-content: center;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--color-rule);
  }
  .diary-index__archive-btn { font-size: 12px; }
</style>
