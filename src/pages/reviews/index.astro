---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import CategoryMasthead from '~/components/CategoryMasthead.astro';
import EditorNoteCard from '~/components/EditorNoteCard.astro';
import LeadPack from '~/components/LeadPack.astro';
import PillarTOC from '~/components/PillarTOC.astro';
import PillarGroup from '~/components/PillarGroup.astro';
import CategoryNewsletterBand from '~/components/CategoryNewsletterBand.astro';
import ArchiveFooter from '~/components/ArchiveFooter.astro';
import TopicChipStrip from '~/components/TopicChipStrip.astro';
import PostCard from '~/components/PostCard.astro';

// ---------------------------------------------------------------------------
// Per-category curated config
// ---------------------------------------------------------------------------

const category = {
  slug: 'reviews',
  number: '03',
  title: 'Reviews',
  lede:
    "Honest, long-term reviews of things I've lived with — not press samples tested over a weekend. Every review is based on months or years of real use, in a busy family of six.",
  cadence: 'Updated monthly',
  editorNote: {
    quote:
      "If a thing breaks, you'll hear about it. If it survived three years and a toddler with a spoon, you'll hear about that too. I buy everything I review — no exceptions.",
    authorName: 'Daniel Betts',
    authorRole: 'Writer, The Breaking Dad',
    authorInitial: 'D',
  },
  startHere: {
    /** Top-rated, most-recent. Set explicitly to override the default. */
    heroSlug: '',
    supportingSlugs: [] as string[],
  },
};

const pillars = [
  {
    slug: 'family-tech',
    title: 'Family tech',
    dek: 'Screens, smart things, and the tech that earns its keep.',
    featuredSlugs: [] as string[],
    cardLimit: 3,
  },
  {
    slug: 'parenting-kit',
    title: 'Parenting kit',
    dek: 'The everyday gear that makes a real difference.',
    featuredSlugs: [] as string[],
    cardLimit: 3,
  },
  {
    slug: 'shoes-and-fitness',
    title: 'Shoes and fitness',
    dek: 'What stays on my feet and what keeps me moving.',
    featuredSlugs: [] as string[],
    cardLimit: 3,
  },
  {
    slug: 'home-and-lifestyle',
    title: 'Home and lifestyle',
    dek: 'Products for the family household, tested in a busy six-person home.',
    featuredSlugs: [] as string[],
    cardLimit: 3,
  },
  {
    slug: 'days-out',
    title: 'Days out',
    dek: 'Family trips, venues, and experiences worth writing about.',
    featuredSlugs: [] as string[],
    cardLimit: 3,
  },
] as const;

// ---------------------------------------------------------------------------
// Data load — `reviews` collection, keyed by `productCategory`
// ---------------------------------------------------------------------------

const allReviews = await getCollection('reviews', ({ data }) => !data.draft);
const sorted = allReviews.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const slugOf = (entry: (typeof sorted)[number]) => entry.id.replace(/\.(md|mdx)$/, '');
const bySlug = new Map(sorted.map((e) => [slugOf(e), e]));
const pillarLabel = Object.fromEntries(pillars.map((p) => [p.slug, p.title]));

const toPostRef = (entry: (typeof sorted)[number]) => {
  const slug = slugOf(entry);
  return {
    title: entry.data.title,
    description: entry.data.description,
    href: `/reviews/${slug}/`,
    image: entry.data.heroImage,
    imageAlt: entry.data.heroAlt,
    date: entry.data.publishDate,
    categoryLabel: pillarLabel[entry.data.productCategory] ?? entry.data.productCategory,
    categoryHref: `/reviews/#${entry.data.productCategory}`,
  };
};

function resolveFeatured(pillarSlug: string, curated: string[], limit: number) {
  const inPillar = sorted.filter((e) => e.data.productCategory === pillarSlug);
  const seen = new Set<string>();
  const out: ReturnType<typeof toPostRef>[] = [];
  for (const slug of curated) {
    const entry = bySlug.get(slug);
    if (entry && !seen.has(slug)) {
      out.push(toPostRef(entry));
      seen.add(slug);
    }
    if (out.length >= limit) break;
  }
  for (const entry of inPillar) {
    if (out.length >= limit) break;
    const slug = slugOf(entry);
    if (seen.has(slug)) continue;
    out.push(toPostRef(entry));
    seen.add(slug);
  }
  return out;
}

// Default lead-pack hero for reviews: highest-rated, then most-recent.
function topRated() {
  return [...sorted].sort((a, b) => {
    if (b.data.rating !== a.data.rating) return b.data.rating - a.data.rating;
    return b.data.publishDate.getTime() - a.data.publishDate.getTime();
  });
}

function resolveLeadPack() {
  const seen = new Set<string>();
  const ranked = topRated();
  const heroSlug = category.startHere.heroSlug;
  let hero = heroSlug ? bySlug.get(heroSlug) : undefined;
  if (!hero) hero = ranked[0];
  if (hero) seen.add(slugOf(hero));

  const supporting: typeof sorted = [];
  for (const slug of category.startHere.supportingSlugs) {
    const entry = bySlug.get(slug);
    if (entry && !seen.has(slug)) {
      supporting.push(entry);
      seen.add(slug);
    }
    if (supporting.length >= 2) break;
  }
  for (const entry of ranked) {
    if (supporting.length >= 2) break;
    const slug = slugOf(entry);
    if (seen.has(slug)) continue;
    supporting.push(entry);
    seen.add(slug);
  }
  return { hero, supporting };
}

const lead = resolveLeadPack();

const tocItems = pillars.map((p) => ({
  slug: p.slug,
  title: p.title,
  dek: p.dek,
  count: sorted.filter((e) => e.data.productCategory === p.slug).length,
}));

const pillarGroups = pillars.map((p) => ({
  ...p,
  items: resolveFeatured(p.slug, [...p.featuredSlugs], p.cardLimit),
}));

const totalPieces = sorted.length;

const yearMap = new Map<number, number>();
for (const e of sorted) {
  const y = e.data.publishDate.getFullYear();
  yearMap.set(y, (yearMap.get(y) ?? 0) + 1);
}
const years = Array.from(yearMap, ([year, count]) => ({ year, count }));

const activeYearParam = Astro.url.searchParams.get('year');
const activeYear = activeYearParam ? Number(activeYearParam) : undefined;

const chipItems = pillars.map((p) => ({ label: p.title, href: `/reviews/#${p.slug}` }));
---

<BaseLayout
  title={`${category.title} — honest product reviews for parents`}
  description={category.lede}
>
  <div class="container">
    <div class="cat-breadcrumb-row">
      <Breadcrumbs trail={[
        { label: 'Home', href: '/' },
        { label: category.title, href: '/reviews/' },
      ]} />
    </div>
  </div>

  <section class="container cat-masthead-section" aria-label={`${category.title} introduction`}>
    <div class="cat-masthead-grid">
      <CategoryMasthead
        number={category.number}
        title={category.title}
        lede={category.lede}
        pieceCount={totalPieces}
        cadence={category.cadence}
        pillarCount={pillars.length}
      />
      <EditorNoteCard
        quote={category.editorNote.quote}
        authorName={category.editorNote.authorName}
        authorRole={category.editorNote.authorRole}
        authorInitial={category.editorNote.authorInitial}
      />
    </div>
  </section>

  <div class="container cat-chip-row">
    <TopicChipStrip allHref="/reviews/" items={chipItems} />
  </div>

  {lead.hero && (
    <section class="container cat-section" aria-label="Top rated">
      <header class="cat-section__head">
        <div>
          <div class="eyebrow eyebrow-accent cat-section__eyebrow">Top rated</div>
          <h2 class="cat-section__title">The one I'd actually recommend today</h2>
        </div>
        <span class="meta">Highest-rated, most-recent</span>
      </header>
      <LeadPack
        hero={toPostRef(lead.hero)}
        supporting={lead.supporting.map(toPostRef)}
      />
    </section>
  )}

  {/*
    "How we review" editorial module — unique to this pillar, sits between
    the lead pack and the pillar TOC. Replaces the original .method block.
  */}
  <section class="container method-section" aria-label="How we review">
    <div class="method">
      <div class="method__text">
        <div class="eyebrow eyebrow-accent">How we review</div>
        <h2 class="method__title">No press samples. No weekend tests.</h2>
        <p class="method__body">
          I buy everything I review myself. I use it for months, sometimes years, in a real household
          of six. Ratings reflect long-term experience, not first impressions. Affiliate links are
          marked and never change the verdict. <a href="/affiliate-disclosure/">Full disclosure here</a>.
        </p>
      </div>
      <ul class="method__stats">
        <li><span class="method__stat-value">Months+</span><span class="method__stat-label">minimum usage</span></li>
        <li><span class="method__stat-value">£0</span><span class="method__stat-label">sponsored opinions</span></li>
        <li><span class="method__stat-value">6</span><span class="method__stat-label">people stress-testing it</span></li>
      </ul>
    </div>
  </section>

  <section class="container cat-section" aria-label="Browse by category">
    <header class="cat-section__head">
      <div>
        <div class="eyebrow eyebrow-accent cat-section__eyebrow">Browse by category</div>
        <h2 class="cat-section__title">{pillars.length} threads of stuff worth recommending</h2>
      </div>
      <span class="meta">Jump to any category ↓</span>
    </header>
    <PillarTOC items={tocItems} />
  </section>

  {pillarGroups.slice(0, 2).map((p) => (
    <div class="container">
      <PillarGroup
        slug={p.slug}
        title={p.title}
        eyebrow={p.title}
        dek={p.dek}
        moreHref={`/reviews/?pillar=${p.slug}`}
        items={p.items}
      />
    </div>
  ))}

  <CategoryNewsletterBand categoryLabel={category.title} />

  {pillarGroups.slice(2).map((p) => (
    <div class="container">
      <PillarGroup
        slug={p.slug}
        title={p.title}
        eyebrow={p.title}
        dek={p.dek}
        moreHref={`/reviews/?pillar=${p.slug}`}
        items={p.items}
      />
    </div>
  ))}

  <section class="container cat-archive-section" aria-label={`${category.title} archive`}>
    <ArchiveFooter
      categoryLabel={category.title}
      totalPieces={totalPieces}
      archiveHref="/reviews/archive/"
      searchHref="/search/?in=reviews"
      years={years}
      activeYear={activeYear}
      yearBaseHref="/reviews/"
    />
  </section>

  {sorted.length === 0 && (
    <section class="container">
      <p class="cat-empty">Reviews are coming soon.</p>
    </section>
  )}
</BaseLayout>

<style>
  .cat-breadcrumb-row {
    padding: 14px 0;
    border-bottom: 1px solid var(--color-rule-soft);
  }

  .cat-masthead-section { padding-block: 44px 28px; }

  .cat-masthead-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: end;
  }

  .cat-chip-row { padding-block: 0; }

  .cat-section { padding-block: 20px 0; }
  .cat-section + .cat-section { padding-top: 64px; }

  .cat-section__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 22px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-rule);
    gap: 24px;
    flex-wrap: wrap;
  }
  .cat-section__eyebrow { margin-bottom: 6px; }
  .cat-section__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    letter-spacing: -0.018em;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }

  .cat-archive-section { padding-block: 80px; }

  .cat-empty {
    font-family: var(--font-sans);
    color: var(--color-ink-3);
    padding-block: 40px;
  }

  /* ── How we review ─────────────────────────────── */
  .method-section { padding-block: 64px 0; }

  .method {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: center;
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule);
    border-radius: 14px;
    padding: 36px 40px;
  }

  .method__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    letter-spacing: -0.018em;
    line-height: 1.2;
    color: var(--color-ink);
    margin: 8px 0 12px;
    text-wrap: balance;
  }

  .method__body {
    font-family: var(--font-sans);
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--color-ink-2);
    margin: 0;
    max-width: 54ch;
  }

  .method__body :global(a) {
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent-soft);
  }

  .method__stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-rule);
  }

  .method__stats li {
    display: flex;
    flex-direction: column;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .method__stat-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.012em;
    color: var(--color-ink);
    line-height: 1;
  }

  .method__stat-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-ink-3);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 6px;
  }

  @media (max-width: 768px) {
    .cat-masthead-section { padding-block: 26px 20px; }
    .cat-masthead-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .cat-section + .cat-section { padding-top: 40px; }
    .cat-section__title { font-size: 22px; }
    .cat-archive-section { padding-block: 48px; }
    .method-section { padding-block: 40px 0; }
    .method {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 24px 22px;
    }
    .method__title { font-size: 22px; }
  }
</style>
