---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PillarHeader from '~/components/PillarHeader.astro';
import SectionTitle from '~/components/SectionTitle.astro';
import PostCard from '~/components/PostCard.astro';

const allReviews = await getCollection('reviews', ({ data }) => !data.draft);
const sortedReviews = allReviews.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const categories = [
  { slug: 'family-tech', label: 'Family tech', description: 'Screens, smart things, and the tech that earns its keep.' },
  { slug: 'parenting-kit', label: 'Parenting kit', description: 'The everyday gear that makes a real difference.' },
  { slug: 'shoes-and-fitness', label: 'Shoes and fitness', description: 'What stays on my feet and what keeps me moving.' },
  { slug: 'home-and-lifestyle', label: 'Home and lifestyle', description: 'Products for the family household, tested in a busy six-person home.' },
  { slug: 'days-out', label: 'Days out', description: 'Family trips, venues, and experiences worth writing about.' },
];

const categoryLabels: Record<string, string> = Object.fromEntries(
  categories.map((c) => [c.slug, c.label])
);

const categoryCounts: Record<string, number> = {};
for (const r of sortedReviews) {
  categoryCounts[r.data.productCategory] = (categoryCounts[r.data.productCategory] ?? 0) + 1;
}

// Editor's pick = highest-rated, most-recent
const topRated = [...sortedReviews].sort((a, b) => {
  if (b.data.rating !== a.data.rating) return b.data.rating - a.data.rating;
  return b.data.publishDate.getTime() - a.data.publishDate.getTime();
})[0];

const recent = sortedReviews.slice(0, 8);
---

<BaseLayout
  title="Reviews — honest product reviews for parents"
  description="Honest, long-term reviews of products I've actually used as a dad — from barefoot shoes to screen-free kids' tech, home and lifestyle, and days out in Hampshire."
>
  <PillarHeader
    kicker="The Pillar"
    title="Reviews"
    dek="Honest, long-term reviews of things I've lived with — not press samples tested over a weekend. Every review is based on months or years of real use, in a busy family of six."
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Reviews', href: '/reviews/' },
    ]}
  />

  {topRated && (() => {
    const slug = topRated.id.replace(/\.(md|mdx)$/, '');
    const filled = Math.round(topRated.data.rating);
    const empty = 5 - filled;
    return (
      <section class="home-section" aria-label="Top rated">
        <div class="container">
          <SectionTitle kicker="Top rated" title="The one I'd actually recommend today" />
          <article class="top-review">
            <a href={`/reviews/${slug}/`} class="top-review__media" tabindex="-1" aria-hidden="true">
              {topRated.data.heroImage ? (
                <img src={topRated.data.heroImage} alt={topRated.data.heroAlt ?? topRated.data.title} width="720" height="480" loading="eager" />
              ) : (
                <span class="top-review__placeholder">{topRated.data.productName}</span>
              )}
            </a>
            <div class="top-review__body">
              <span class="kicker">{categoryLabels[topRated.data.productCategory] ?? topRated.data.productCategory}</span>
              <h3 class="top-review__title">
                <a href={`/reviews/${slug}/`}>{topRated.data.title}</a>
              </h3>
              <p class="top-review__dek">{topRated.data.description}</p>
              <div class="top-review__meta">
                <span class="top-review__stars" aria-label={`${topRated.data.rating} out of 5`}>
                  {'★'.repeat(filled)}{'☆'.repeat(empty)}
                </span>
                <span class="top-review__score">{topRated.data.rating}/5</span>
                <span class="top-review__dot" aria-hidden="true">·</span>
                <span>{topRated.data.usageDuration}</span>
              </div>
            </div>
          </article>
        </div>
      </section>
    );
  })()}

  <section class="home-section home-section--tinted" aria-label="How we review">
    <div class="container">
      <div class="method">
        <div class="method__text">
          <span class="kicker">How we review</span>
          <h2 class="method__title">No press samples. No weekend tests.</h2>
          <p class="method__body">
            I buy everything I review myself. I use it for months, sometimes years, in a real household of six.
            Ratings reflect long-term experience, not first impressions. Affiliate links are marked and never change the verdict.
            <a href="/affiliate-disclosure/">Full disclosure here</a>.
          </p>
        </div>
        <ul class="method__stats">
          <li><span class="method__stat-value">Months+</span><span class="method__stat-label">minimum usage</span></li>
          <li><span class="method__stat-value">£0</span><span class="method__stat-label">sponsored opinions</span></li>
          <li><span class="method__stat-value">6</span><span class="method__stat-label">people stress-testing it</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="home-section" aria-label="Categories">
    <div class="container">
      <SectionTitle kicker="Browse by category" />
      <ol class="subhub-list">
        {categories.map((cat, i) => (
          <li class="subhub-item">
            <a href={`#${cat.slug}`} class="subhub-item__link">
              <span class="subhub-item__number">{String(i + 1).padStart(2, '0')}</span>
              <div class="subhub-item__body">
                <h3 class="subhub-item__title">{cat.label}</h3>
                <p class="subhub-item__description">{cat.description}</p>
              </div>
              <span class="subhub-item__count">
                {categoryCounts[cat.slug] ?? 0} {(categoryCounts[cat.slug] ?? 0) === 1 ? 'review' : 'reviews'}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {categories.map((cat) => {
    const reviewsForCat = sortedReviews.filter((r) => r.data.productCategory === cat.slug);
    if (reviewsForCat.length === 0) return null;
    return (
      <section class="home-section" id={cat.slug} aria-label={cat.label}>
        <div class="container">
          <SectionTitle kicker={cat.label} title={cat.description} />
          <div class="card-grid card-grid--4">
            {reviewsForCat.slice(0, 4).map((review) => {
              const slug = review.id.replace(/\.(md|mdx)$/, '');
              return (
                <PostCard
                  title={review.data.title}
                  description={review.data.description}
                  href={`/reviews/${slug}/`}
                  image={review.data.heroImage}
                  imageAlt={review.data.heroAlt}
                  categoryLabel={categoryLabels[review.data.productCategory] ?? review.data.productCategory}
                  categoryHref="/reviews/"
                  date={review.data.publishDate}
                  rating={review.data.rating}
                />
              );
            })}
          </div>
        </div>
      </section>
    );
  })}
</BaseLayout>

<style>
  .home-section {
    padding-block: 2.75rem;
  }

  .home-section--tinted {
    background: var(--color-surface);
  }

  /* Top review spotlight */
  .top-review {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 820px) {
    .top-review {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  .top-review__media {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--color-accent) 12%, var(--color-surface)),
      color-mix(in srgb, var(--color-highlight) 22%, var(--color-surface))
    );
    text-decoration: none;
    position: relative;
  }

  .top-review__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .top-review__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--color-muted);
    text-align: center;
    padding: 1rem;
  }

  .top-review__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .top-review__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 2.125rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .top-review__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .top-review__title a:hover {
    color: var(--color-accent);
  }

  .top-review__dek {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0;
    max-width: 48ch;
  }

  .top-review__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-muted);
    padding-top: 0.375rem;
  }

  .top-review__stars {
    color: var(--color-highlight);
    font-size: 1rem;
    letter-spacing: 0.05em;
  }

  .top-review__score {
    font-weight: 700;
    color: var(--color-text);
  }

  .top-review__dot {
    color: var(--color-hairline);
    font-weight: 700;
  }

  /* How we review method module */
  .method {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 820px) {
    .method {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  .method__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0.5rem 0 0.75rem;
  }

  .method__body {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin: 0;
    max-width: 54ch;
  }

  .method__body a {
    color: var(--color-accent);
  }

  .method__stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-hairline);
  }

  .method__stats li {
    display: flex;
    flex-direction: column;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .method__stat-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1;
  }

  .method__stat-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  /* Numbered category list (shared pattern) */
  .subhub-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-hairline);
  }

  .subhub-item {
    border-bottom: 1px solid var(--color-hairline);
  }

  .subhub-item__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.5rem 0;
    text-decoration: none;
    transition: padding 0.2s ease;
  }

  @media (max-width: 560px) {
    .subhub-item__link {
      grid-template-columns: auto 1fr;
      gap: 1rem;
    }
    .subhub-item__count {
      grid-column: 2;
      justify-self: start;
      margin-top: 0.25rem;
    }
  }

  .subhub-item__link:hover {
    padding-left: 0.5rem;
    background: color-mix(in srgb, var(--color-accent) 4%, transparent);
  }

  .subhub-item__number {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    font-feature-settings: "tnum";
    padding-top: 0.375rem;
  }

  .subhub-item__body {
    display: grid;
    gap: 0.375rem;
  }

  .subhub-item__title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-text);
    transition: color 0.15s;
  }

  .subhub-item__link:hover .subhub-item__title {
    color: var(--color-accent);
  }

  .subhub-item__description {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0;
    max-width: 52ch;
  }

  .subhub-item__count {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
</style>
